# Production: set these as private environment variables in the Vercel project.
# Use a pooled PostgreSQL connection URL with TLS. Do not prefix with NEXT_PUBLIC_.
# Example: postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DATABASE_URL=
# Use distinct, randomly generated access codes, each at least 16 characters.
BOOKING_ADMIN_CODE=
BOOKING_RECEPTION_CODE=

# Optional local testing only; never used when VERCEL is set.
# BOOKING_LOCAL_SQLITE=/tmp/adventure-bookings-development.sqlite
